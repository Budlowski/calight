#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Application\Bootstrap;
use App\Infrastructure\Database\Migrator;
use App\Infrastructure\Persistence\UserRepository;
use App\Support\Clock;
use App\Support\Uuid;

$root = dirname(__DIR__);
if (!is_file($root . '/vendor/autoload.php')) {
    fwrite(STDERR, "Abhaengigkeiten fehlen. Bitte zuerst 'composer install' ausfuehren.\n");
    exit(1);
}
require $root . '/vendor/autoload.php';

$bootstrap = Bootstrap::create($root);
$command = $argv[1] ?? 'help';

try {
    if ($command === 'migrate') {
        $applied = (new Migrator($bootstrap->pdo, $root . '/migrations'))->migrate();
        if ($applied === []) {
            echo "Keine offenen Migrationen.\n";
        } else {
            foreach ($applied as $version) {
                echo "Migration ausgefuehrt: {$version}\n";
            }
        }
        exit(0);
    }

    if ($command === 'user:create') {
        $username = trim((string) ($argv[2] ?? ''));
        $displayName = trim((string) ($argv[3] ?? ''));
        $role = trim((string) ($argv[4] ?? 'admin'));
        if ($username === '' || $displayName === '') {
            throw new RuntimeException('Aufruf: php bin/console user:create <benutzername> "<Anzeigename>" [admin|office|technician]');
        }
        if(!in_array($role,['admin','office','technician'],true))throw new RuntimeException('Die Rolle muss admin, office oder technician sein.');
        $password = readPassword('Passwort: ');
        $confirmation = readPassword('Passwort wiederholen: ');
        if ($password !== $confirmation) {
            throw new RuntimeException('Die Passwoerter stimmen nicht ueberein.');
        }
        if (mb_strlen($password) < 8) {
            throw new RuntimeException('Das Passwort muss mindestens 8 Zeichen lang sein.');
        }
        $users = new UserRepository($bootstrap->pdo);
        $users->create(Uuid::v4(), $username, password_hash($password, PASSWORD_DEFAULT), $displayName, Clock::now(),$role);
        echo "Benutzerkonto mit Rolle {$role} wurde angelegt.\n";
        exit(0);
    }

    echo "Verfuegbare Befehle:\n";
    echo "  migrate\n";
    echo "  user:create <benutzername> \"<Anzeigename>\" [admin|office|technician]\n";
    exit($command === 'help' ? 0 : 1);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Fehler: ' . $exception->getMessage() . "\n");
    exit(1);
}

function readPassword(string $prompt): string
{
    fwrite(STDOUT, $prompt);
    $sttyAvailable = trim((string) shell_exec('command -v stty 2>/dev/null')) !== '';
    if ($sttyAvailable) {
        shell_exec('stty -echo');
    }
    $value = trim((string) fgets(STDIN));
    if ($sttyAvailable) {
        shell_exec('stty echo');
        fwrite(STDOUT, "\n");
    }
    return $value;
}
