{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:kalkulationssoftware:offer:v1",
    "title": "Angebotsentwurf Schema 1",
    "type": "object",
    "required": ["schemaVersion", "id", "projectId", "offerNumber", "revision", "status", "title", "createdAt", "updatedAt", "nodes"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "format": "uuid" },
        "projectId": { "type": "string", "format": "uuid" },
        "offerNumber": { "type": ["string", "null"] },
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "const": "draft" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "nodes": {
            "type": "array",
            "items": { "$ref": "#/$defs/node" }
        },
        "calculation": { "type": "object" }
    },
    "additionalProperties": false,
    "$defs": {
        "node": {
            "oneOf": [
                { "$ref": "#/$defs/title" },
                { "$ref": "#/$defs/position" }
            ]
        },
        "title": {
            "type": "object",
            "required": ["id", "type", "name", "description", "children"],
            "properties": {
                "id": { "type": "string", "format": "uuid" },
                "type": { "const": "title" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
                "calculation": { "type": "object" }
            },
            "additionalProperties": false
        },
        "position": {
            "type": "object",
            "required": ["id", "type", "positionType", "shortText", "longText", "quantity", "unit", "manualUnitPrice", "components"],
            "properties": {
                "id": { "type": "string", "format": "uuid" },
                "type": { "const": "position" },
                "positionType": { "enum": ["normal", "bedarf", "alternative"] },
                "shortText": { "type": "string", "minLength": 1 },
                "longText": { "type": "string" },
                "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$" },
                "unit": { "type": "string", "minLength": 1 },
                "manualUnitPrice": {
                    "type": ["string", "null"],
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
                },
                "components": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/component" }
                },
                "sourceServiceId": { "type": ["string", "null"] },
                "sourceServiceNumber": { "type": ["string", "null"] },
                "calculation": { "type": ["object", "null"] }
            },
            "additionalProperties": false
        },
        "component": {
            "type": "object",
            "required": ["id", "name", "calculationType", "unit", "quantity", "costPrice", "markupPercent", "masterDataId"],
            "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string", "minLength": 1 },
                "calculationType": { "enum": ["material", "labor", "external", "other"] },
                "unit": { "type": "string", "minLength": 1 },
                "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$" },
                "costPrice": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$" },
                "markupPercent": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$" },
                "masterDataId": { "type": ["string", "null"], "format": "uuid" },
                "priceLocked": { "type": "boolean" },
                "priceMode": { "enum": ["master", "locked", "manual"] },
                "sourceArticleNumber": { "type": ["string", "null"] },
                "masterDataSnapshot": { "type": ["object", "null"] }
            },
            "additionalProperties": false
        }
    }
}
